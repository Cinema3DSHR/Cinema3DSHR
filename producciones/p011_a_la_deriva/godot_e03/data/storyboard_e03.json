  "s4": {
   "titulo": "Cap. 3 · Escena 4 · Un momento entre los dos",
   "dur": 37.38,
   "voces": [
    {
     "t": 2.0,
     "dur": 5.878,
     "quien": "aiden",
     "texto": "[tired, soft] Se estabilizaron tres de las cuatro. La última aguanta, pero hay que vigilarla.",
     "mp3": "data/voz/voz_c15af117ded2bf70.mp3",
     "alineacion_res": "data/alin/voz_c15af117ded2bf70.alin.json",
     "exp": {
