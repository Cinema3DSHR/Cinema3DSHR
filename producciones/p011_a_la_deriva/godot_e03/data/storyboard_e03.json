      "kate": "sorpresa"
     }
    },
    {
     "t": 16.125,
     "dur": 1.724,
     "quien": "kate",
     "texto": "[quiet, a little smile] Sí. Me llegó bien.",
     "mp3": "data/voz/voz_df28c91ade7ecfda.mp3",
     "alineacion_res": "data/alin/voz_df28c91ade7ecfda.alin.json",
     "exp": {
      "aiden": "sonrisa_suave",
      "kate": "sonrisa_suave"
     }
    },
    {
     "t": 18.299,
     "dur": 5.146,
     "quien": "aiden",
     "texto": "[relieved, soft] Qué bueno. No sabía si... bueno. Qué bueno.",
     "mp3": "data/voz/voz_afa18e4fdf7f9e63.mp3",
     "alineacion_res": "data/alin/voz_afa18e4fdf7f9e63.alin.json",
     "exp": {
      "aiden": "sonrisa_suave",
      "kate": "sonrisa_suave"
     }
    },
    {
     "t": 23.895,
     "dur": 2.769,
     "quien": "kate",
     "texto": "[gentle, honest] Gracias de nuevo. Y no lo digo por cortesía.",
     "mp3": "data/voz/voz_909b344341b041b9.mp3",
     "alineacion_res": "data/alin/voz_909b344341b041b9.alin.json",
     "exp": {
      "aiden": "sonrisa_suave",
      "kate": "sonrisa_suave"
     }
    },
