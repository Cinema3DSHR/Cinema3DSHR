    {
     "t": 8.328,
     "dur": 2.926,
     "quien": "kate",
     "texto": "[quiet] Me quedo yo. Hoy me ocupo de esa incubadora.",
     "mp3": "data/voz/voz_43679e95a1721746.mp3",
     "alineacion_res": "data/alin/voz_43679e95a1721746.alin.json",
     "exp": {
      "aiden": "cansado",
      "kate": "seria"
     }
    },
    {
     "t": 11.704,
     "dur": 3.971,
     "quien": "aiden",
     "texto": "[awkward, soft] Keit. ¿La flor... te llegó bien?",
     "mp3": "data/voz/voz_82fdbd2dc0af361a.mp3",
     "alineacion_res": "data/alin/voz_82fdbd2dc0af361a.alin.json",
     "exp": {
